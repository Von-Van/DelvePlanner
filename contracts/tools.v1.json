          "$ref": "#/$defs/instant"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/memoryKind"
        },
        "planId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedAt": {
          "$ref": "#/$defs/instant"
        },
        "relevance": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "source": {
          "enum": [
            "user_stated",
            "user_correction",
            "approved_action",
            "assistant_inferred"
          ]
        },
        "trust": {
          "description": "verified: from a change the person approved. user_confirmed: the person said, corrected or confirmed it. inferred: the assistant's unconfirmed guess; never present it as fact.",
          "enum": [
            "verified",
            "user_confirmed",
            "inferred"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "content",
