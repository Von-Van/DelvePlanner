  "$id": "https://github.com/Von-Van/DelvePlanner/contracts/tools.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "budgets": {
    "ceiling": {
      "maxCallMs": 10000,
      "maxIdenticalFailures": 5,
      "maxResultBytes": 262144,
      "maxToolCalls": 200
    },
    "default": {
      "maxCallMs": 2000,
      "maxIdenticalFailures": 2,
      "maxResultBytes": 65536,
      "maxToolCalls": 24
    }
  },
  "description": "DelveOps read tools served by the Rust tool broker. Every tool is read-only. Records carry id and, where stored, revision. Times are UTC instants or local YYYY-MM-DD days with the timeZone they were read in. Descriptions and notes are left out unless the run's privacy policy allows them; read-only calendar events are reduced to busy times with no titles.",
  "errorCodes": [
    {
      "code": "invalid_arguments",
      "retryable": false
    },
    {
      "code": "not_found",
      "retryable": false
    },
    {
      "code": "ambiguous",
      "retryable": false
    },
    {
      "code": "permission_denied",
      "retryable": false
    },
    {
      "code": "timeout",
      "retryable": true
    },
    {
      "code": "unavailable",
      "retryable": true
    },
    {
      "code": "budget_exhausted",
      "retryable": false
    },
    {
      "code": "internal",
      "retryable": true
    }
  ],
  "tools": [
    {
      "description": "Everything on one local day: planner events, tasks scheduled or due that day, milestones due, time blocks, busy times from read-only calendars (no titles), working and available minutes, and free time ranges.",
      "implemented": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "$ref": "#/$defs/localDate"
          },
          "timeZone": {
            "$ref": "#/$defs/timeZone"
          }
        },
        "required": [
          "date",
          "timeZone"
        ],
        "type": "object"
      },
      "name": "get_day_context",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "availableMinutes": {
            "type": "integer"
          },
          "calendarsIncomplete": {
            "type": "boolean"
          },
          "date": {
            "$ref": "#/$defs/localDate"
          },
          "dueTasks": {
            "items": {
              "$ref": "#/$defs/task"
            },
            "type": "array"
          },
          "events": {
            "items": {
              "$ref": "#/$defs/event"
            },
            "type": "array"
          },
          "externalBusy": {
            "items": {
              "$ref": "#/$defs/busyTime"
            },
            "type": "array"
          },
          "free": {
            "items": {
              "$ref": "#/$defs/timeRange"
            },
            "type": "array"
          },
          "milestones": {
            "items": {
              "$ref": "#/$defs/milestone"
            },
            "type": "array"
          },
          "plannedMinutes": {
            "type": "integer"
          },
          "scheduledTasks": {
            "items": {
              "$ref": "#/$defs/task"
            },
            "type": "array"
          },
          "taskBlocks": {
            "items": {
              "$ref": "#/$defs/taskBlock"
            },
            "type": "array"
          },
          "timeZone": {
            "$ref": "#/$defs/timeZone"
          },
          "truncated": {
            "type": "boolean"
          },
          "workingMinutes": {
            "type": "integer"
          }
        },
        "required": [
          "date",
          "timeZone",
          "events",
          "scheduledTasks",
          "dueTasks",
          "milestones",
          "taskBlocks",
          "externalBusy",
          "calendarsIncomplete",
          "workingMinutes",
          "availableMinutes",
          "plannedMinutes",
          "free",
          "truncated"
        ],
        "type": "object"
      },
      "permissionScope": "planner.read+calendar.busy",
      "privacyClass": "planner_and_calendar_busy"
    },
    {
      "description": "Plans that are active (and optionally still being planned), with task counts, overdue counts, and their milestones. Use it to find a plan's id.",
      "implemented": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "includePlanning": {
            "default": false,
            "description": "Also list plans whose status is planning.",
            "type": "boolean"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "list_active_projects",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "asOf": {
            "$ref": "#/$defs/localDate"
          },
          "plans": {
            "items": {
              "$ref": "#/$defs/projectSummary"
            },
            "type": "array"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "asOf",
          "plans",
          "truncated"
        ],
        "type": "object"
      },
      "permissionScope": "planner.read",
      "privacyClass": "planner"
    },
    {
      "description": "One plan by id: its milestones, workstreams, and tasks with ids, revisions, statuses, dates, and what each task waits on.",
      "implemented": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "planId": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "planId"
        ],
        "type": "object"
      },
      "name": "get_project_context",
