{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_bench/schemas/draft.v0.json",
  "title": "Proposal draft v0",
  "description": "What an agent may return instead of writing. `op` is exactly one variant of MutationOperation in src-tauri/src/model.rs (snake_case); see section 2 of the overhaul plan (kept outside the repo). For operations on an existing record, `target` carries its id and revision (Rust's taskId/eventId/... and expectedRevision); `payload` holds the variant's remaining fields in camelCase. Rust re-validates target and revision before anything reaches review.",
  "type": "object",
  "required": [
    "op",
    "target",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "op": {
      "enum": [
        "create_event",
        "update_event",
        "delete_event",
        "reschedule_event",
        "set_event_plan",
        "create_plan",
        "update_plan",
        "create_milestone",
        "update_milestone",
        "delete_milestone",
        "create_task",
        "update_task",
        "schedule_task",
        "set_task_plan",
        "delete_task",
        "create_workstream",
        "set_task_workstream"
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "payload": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-operations": {
    "$comment": "Per-operation payload fields, from MutationOperation in src-tauri/src/model.rs (serde camelCase, deny_unknown_fields). `required` are non-Option fields without a serde default; `optional` may be omitted (Rust reads them as None). `targetless` operations create a record and take target null; all others need target {id, revision}, which become the variant's id field and expectedRevision.",
    "targetless": [
      "create_event",
      "create_plan",
      "create_milestone",
      "create_task",
      "create_workstream"
    ],
    "fields": {
      "create_event": {
        "required": [
          "title",
          "notes",
          "startAtUtc",
          "timeZone",
          "durationMinutes"
        ],
        "optional": [
          "reminderMinutesBefore",
          "plan",
          "fromInbox"
        ]
      },
      "update_event": {
        "required": [
          "reminderChange"
        ],
        "optional": [
          "title",
          "notes",
          "durationMinutes"
        ]
      },
      "delete_event": {
        "required": [],
        "optional": []
      },
      "reschedule_event": {
        "required": [
          "startAtUtc",
          "timeZone",
          "reminderChange"
        ],
        "optional": [
          "title",
          "notes",
          "durationMinutes"
        ]
      },
      "set_event_plan": {
        "required": [],
        "optional": [
          "plan"
        ]
      },
      "create_plan": {
        "required": [
          "title",
          "description",
          "status"
        ],
        "optional": [
          "startDate",
          "targetDate",
          "fromInbox"
        ]
      },
      "update_plan": {
        "required": [],
        "optional": [
          "title",
          "description",
          "status",
          "startDate",
          "targetDate"
        ]
      },
      "create_milestone": {
        "required": [
          "plan",
          "title",
          "description"
        ],
        "optional": [
          "targetDate"
        ]
      },
      "update_milestone": {
        "required": [],
        "optional": [
          "title",
          "description",
          "targetDate",
          "status"
        ]
      },
      "delete_milestone": {
        "required": [],
        "optional": []
      },
      "create_task": {
        "required": [
          "title",
          "description",
          "status",
          "priority"
        ],
        "optional": [
          "plan",
          "milestone",
          "scheduledDay",
          "dueDate",
          "workstream",
          "fromInbox"
        ]
      },
      "update_task": {
        "required": [
          "estimate"
        ],
        "optional": [
          "title",
          "description",
          "status",
          "priority"
        ]
      },
      "schedule_task": {
        "required": [
          "scheduledDay",
          "dueDate",
          "plannedWeek"
        ],
        "optional": []
      },
      "set_task_plan": {
        "required": [],
        "optional": [
          "plan",
          "milestone"
        ]
      },
      "delete_task": {
        "required": [],
        "optional": []
      },
      "create_workstream": {
        "required": [
          "plan",
          "name"
        ],
        "optional": []
      },
      "set_task_workstream": {
        "required": [],
        "optional": [
          "workstream"
        ]
      }
    }
  }
}
